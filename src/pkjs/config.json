[
  {
    "type": "heading",
    "defaultValue": "Karakeep Reader"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Conexión"
      },
      {
        "type": "input",
        "messageKey": "SERVER_URL",
        "label": "URL de tu Karakeep",
        "description": "Por ejemplo https://karakeep.example.com (sin /api).",
        "attributes": {
          "placeholder": "https://karakeep.example.com",
          "type": "url"
        }
      },
      {
        "type": "input",
        "messageKey": "API_KEY",
        "label": "API key",
        "description": "Créala en Karakeep: Ajustes > API Keys.",
        "attributes": {
          "type": "password"
        }
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Lista"
      },
      {
        "type": "select",
        "messageKey": "LIST_FILTER",
        "label": "Qué mostrar",
        "defaultValue": "unarchived",
        "options": [
          {
            "label": "Sin archivar",
            "value": "unarchived"
          },
          {
            "label": "Favoritos",
            "value": "favourites"
          },
          {
            "label": "Todos",
            "value": "all"
          }
        ]
      },
      {
        "type": "slider",
        "messageKey": "MAX_ITEMS",
        "label": "Número de artículos",
        "defaultValue": 20,
        "min": 5,
        "max": 30,
        "step": 5
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Letra"
      },
      {
        "type": "select",
        "messageKey": "LIST_FONT",
        "label": "Tamaño en la lista",
        "defaultValue": 0,
        "options": [
          {
            "label": "Automático (como el reloj)",
            "value": 0
          },
          {
            "label": "Pequeño",
            "value": 1
          },
          {
            "label": "Medio",
            "value": 2
          },
          {
            "label": "Grande",
            "value": 3
          },
          {
            "label": "Muy grande",
            "value": 4
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "ARTICLE_FONT",
        "label": "Tamaño en el artículo",
        "defaultValue": 0,
        "options": [
          {
            "label": "Automático (como el reloj)",
            "value": 0
          },
          {
            "label": "Pequeño",
            "value": 1
          },
          {
            "label": "Medio",
            "value": 2
          },
          {
            "label": "Grande",
            "value": 3
          },
          {
            "label": "Muy grande",
            "value": 4
          }
        ],
        "description": "Automático usa el tamaño de texto configurado en los ajustes del reloj."
