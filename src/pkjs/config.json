  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Aspecto"
      },
      {
        "type": "select",
        "messageKey": "THEME",
        "label": "Tema",
        "defaultValue": 0,
        "options": [
          {
            "label": "Claro",
            "value": 0
          },
          {
            "label": "Oscuro",
            "value": 1
          }
        ]
