[
  {
    "type": "heading",
    "defaultValue": "Karakeep Reader"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Connection"
      },
      {
        "type": "input",
        "messageKey": "SERVER_URL",
        "label": "Your Karakeep URL",
        "description": "For example https://karakeep.example.com (without /api).",
        "attributes": {
          "placeholder": "https://karakeep.example.com",
          "type": "url"
        }
      },
      {
        "type": "input",
        "messageKey": "API_KEY",
        "label": "API key",
        "description": "Create one in Karakeep under Settings > API Keys.",
        "attributes": {
          "type": "password"
        }
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "List"
      },
      {
        "type": "select",
        "messageKey": "LIST_FILTER",
        "label": "What to show",
        "defaultValue": "unarchived",
        "options": [
          {
            "label": "Not archived",
            "value": "unarchived"
          },
          {
            "label": "Favourites",
            "value": "favourites"
          },
          {
            "label": "All",
            "value": "all"
          }
        ]
      },
      {
        "type": "slider",
        "messageKey": "MAX_ITEMS",
        "label": "Number of articles",
        "defaultValue": 20,
        "min": 5,
        "max": 30,
        "step": 5
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Font"
      },
      {
        "type": "select",
        "messageKey": "LIST_FONT",
        "label": "Size in the list",
        "defaultValue": 0,
        "options": [
          {
            "label": "Automatic (same as the watch)",
            "value": 0
          },
          {
            "label": "Small",
            "value": 1
          },
          {
            "label": "Medium",
            "value": 2
          },
          {
            "label": "Large",
            "value": 3
          },
          {
            "label": "Extra large",
            "value": 4
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "ARTICLE_FONT",
        "label": "Size in the article",
        "defaultValue": 0,
        "options": [
          {
            "label": "Automatic (same as the watch)",
            "value": 0
          },
          {
            "label": "Small",
            "value": 1
          },
          {
            "label": "Medium",
            "value": 2
          },
          {
            "label": "Large",
            "value": 3
          },
          {
            "label": "Extra large",
            "value": 4
          }
        ],
        "description": "Automatic uses the text size set in your watch settings."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Appearance"
      },
      {
        "type": "select",
        "messageKey": "THEME",
        "label": "Theme",
        "defaultValue": 0,
        "options": [
          {
            "label": "Light",
            "value": 0
          },
          {
            "label": "Dark",
            "value": 1
          }
        ]
      }
    ]
  },
  {
    "type": "submit",
    "defaultValue": "Save"
  }
]